get_filename_component(root "${PACKAGE_ROOT}" ABSOLUTE)
if(NOT EXISTS "${root}/runtime/zSpace_Core.dll")
  return()
endif()
foreach(part core toolset/slicer)
  foreach(name zSpace_Core zSpace_Interface zSpace_IO zSpace_Toolsets zspace_usd usd_ms tbb12 vcomp140)
    if(EXISTS "${root}/${part}/${name}.dll")
      if(name STREQUAL "vcomp140" AND NOT EXISTS "${root}/runtime/vcomp140.dll")
        file(COPY "${root}/${part}/${name}.dll" DESTINATION "${root}/runtime")
      endif()
      file(REMOVE "${root}/${part}/${name}.dll")
    endif()
  endforeach()
endforeach()
if(EXISTS "${root}/runtime/usd/plugInfo.json")
  foreach(part core/usd toolset/slicer/usd plugin toolset/plugin)
    get_filename_component(old "${root}/${part}" ABSOLUTE)
    cmake_path(IS_PREFIX root "${old}" NORMALIZE inside)
    if(NOT inside OR old STREQUAL root)
      message(FATAL_ERROR "Invalid legacy runtime path")
    endif()
    file(REMOVE_RECURSE "${old}")
  endforeach()
endif()
