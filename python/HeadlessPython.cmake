# Shared configuration for standalone Core and combined Toolsets builds.
add_compile_definitions(NOMINMAX WIN32_LEAN_AND_MEAN)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(PYBIND11_FINDPYTHON ON)
find_package(Python REQUIRED COMPONENTS Interpreter Development.Module)
find_package(pybind11 CONFIG REQUIRED)
set(ZSPACE_BUILD_INTERFACE ON CACHE BOOL "" FORCE)
option(ZSPACE_PYTHON_WITH_USD "Enable generic Core USD document IO" OFF)
set(ZSPACE_BUILD_IO ${ZSPACE_PYTHON_WITH_USD} CACHE BOOL "" FORCE)
set(ZSPACE_IO_WITH_OPENUSD ${ZSPACE_PYTHON_WITH_USD} CACHE BOOL "" FORCE)
set(ZSPACE_IO_WITH_TINYUSDZ OFF CACHE BOOL "" FORCE)
foreach(opt DISPLAY INTEROP TESTS)
  set(ZSPACE_BUILD_${opt} OFF CACHE BOOL "" FORCE)
endforeach()
set(ZSPACE_WITH_OPENGL OFF CACHE BOOL "" FORCE)
set(ZSPACE_BUILD_SHARED ON CACHE BOOL "" FORCE)
