include_guard(GLOBAL)
if(POLICY CMP0177)
  cmake_policy(SET CMP0177 NEW)
endif()

# Called only by Core, after its SDK has been resolved.
function(zspace_prepare_io_runtime)
  if(NOT WIN32)
    return()
  endif()
  set(root "${ZSPACE_OPENUSD_ROOT}")
  if(ZSPACE_OPENUSD_RUNTIME_ROOT)
    set(root "${ZSPACE_OPENUSD_RUNTIME_ROOT}")
  endif()
  if(EXISTS "${root}/lib/zspace_usd.dll")
    set(seeds "${root}/lib/zspace_usd.dll")
  elseif(EXISTS "${root}/lib/usd_ms.dll")
    set(seeds "${root}/lib/usd_ms.dll")
  else()
    file(GLOB seeds "${root}/bin/usd*.dll" "${root}/lib/usd*.dll")
  endif()
  if(NOT seeds OR NOT EXISTS "${root}/lib/usd/plugInfo.json")
    message(FATAL_ERROR "Core OpenUSD: incomplete Windows runtime at ${root}")
  endif()
  get_filename_component(compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
  find_program(dumpbin NAMES dumpbin HINTS "${compiler_dir}" REQUIRED)
  set(manifest "${CMAKE_CURRENT_BINARY_DIR}/zspace-usd-runtime.cmake")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${root}" "-DSEEDS=${seeds}"
    "-DDUMPBIN=${dumpbin}" "-DOUTPUT=${manifest}"
    -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ZSpaceUSDDependencies.cmake"
    RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Core OpenUSD runtime dependency inspection failed")
  endif()
  include("${manifest}")
  set_property(GLOBAL PROPERTY ZSPACE_IO_RUNTIME_FILES "${ZSPACE_USD_RUNTIME_FILES}")
  set_property(GLOBAL PROPERTY ZSPACE_IO_RESOURCE_ROOT "${root}/lib/usd")
  install(FILES ${ZSPACE_USD_RUNTIME_FILES} DESTINATION bin)
  install(DIRECTORY "${root}/lib/usd" DESTINATION bin)
  # Preserve plugin resources in their installed SDK-relative location.
  if(EXISTS "${root}/plugin")
    set_property(GLOBAL PROPERTY ZSPACE_IO_PLUGIN_ROOT "${root}/plugin")
    install(DIRECTORY "${root}/plugin" DESTINATION .)
  endif()
  set(installed_manifest "")
  foreach(dll IN LISTS ZSPACE_USD_RUNTIME_FILES)
    get_filename_component(name "${dll}" NAME)
    string(APPEND installed_manifest "list(APPEND files \"\${PACKAGE_PREFIX_DIR}/bin/${name}\")\n")
  endforeach()
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/zspaceRuntimeFiles.cmake"
    "set(files)\n${installed_manifest}set_property(GLOBAL PROPERTY ZSPACE_IO_RUNTIME_FILES \"\${files}\")\nset_property(GLOBAL PROPERTY ZSPACE_IO_RESOURCE_ROOT \"\${PACKAGE_PREFIX_DIR}/bin/usd\")\nset_property(GLOBAL PROPERTY ZSPACE_IO_PLUGIN_ROOT \"\${PACKAGE_PREFIX_DIR}/plugin\")\n")
  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/zspaceRuntimeFiles.cmake" DESTINATION lib/cmake/zspace)
endfunction()

# Consumer knows only the Core component and destination, never the USD SDK.
function(zspace_deploy_runtime)
  cmake_parse_arguments(ARG "" "TARGET;INSTALL_DESTINATION;DESTINATION;PLUGIN_DESTINATION" "COMPONENTS" ${ARGN})
  if(NOT TARGET "${ARG_TARGET}")
    message(FATAL_ERROR "zspace_deploy_runtime requires a valid TARGET")
  endif()
  foreach(component IN LISTS ARG_COMPONENTS)
    if(NOT component STREQUAL "io")
      message(FATAL_ERROR "Unsupported Core runtime component: ${component}")
    endif()
  endforeach()
  if(NOT "io" IN_LIST ARG_COMPONENTS)
    return()
  endif()
  if(NOT ARG_DESTINATION)
    set(ARG_DESTINATION "$<TARGET_FILE_DIR:${ARG_TARGET}>")
  endif()
  if(NOT ARG_PLUGIN_DESTINATION)
    set(ARG_PLUGIN_DESTINATION "${ARG_DESTINATION}/../plugin")
  endif()
  add_custom_command(TARGET ${ARG_TARGET} POST_BUILD COMMAND "${CMAKE_COMMAND}" -E
    make_directory "${ARG_DESTINATION}" VERBATIM)
  get_property(files GLOBAL PROPERTY ZSPACE_IO_RUNTIME_FILES)
  foreach(dll IN LISTS files)
    add_custom_command(TARGET ${ARG_TARGET} POST_BUILD COMMAND "${CMAKE_COMMAND}" -E
      copy_if_different "${dll}" "${ARG_DESTINATION}" VERBATIM)
    if(ARG_INSTALL_DESTINATION)
      install(FILES "${dll}" DESTINATION "${ARG_INSTALL_DESTINATION}")
    endif()
  endforeach()
  get_property(resources GLOBAL PROPERTY ZSPACE_IO_RESOURCE_ROOT)
  if(resources)
    add_custom_command(TARGET ${ARG_TARGET} POST_BUILD COMMAND "${CMAKE_COMMAND}" -E
      copy_directory "${resources}" "${ARG_DESTINATION}/usd" VERBATIM)
    if(ARG_INSTALL_DESTINATION)
      install(DIRECTORY "${resources}" DESTINATION "${ARG_INSTALL_DESTINATION}")
    endif()
  endif()
  get_property(plugins GLOBAL PROPERTY ZSPACE_IO_PLUGIN_ROOT)
  if(plugins AND EXISTS "${plugins}")
    add_custom_command(TARGET ${ARG_TARGET} POST_BUILD COMMAND "${CMAKE_COMMAND}" -E
      copy_directory "${plugins}" "${ARG_PLUGIN_DESTINATION}" VERBATIM)
    if(ARG_INSTALL_DESTINATION)
      install(DIRECTORY "${plugins}" DESTINATION "${ARG_INSTALL_DESTINATION}/..")
    endif()
  endif()
endfunction()
