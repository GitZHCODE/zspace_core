foreach(required zspace_core.js zspace_core.wasm)
  if(NOT EXISTS "${ROOT}/${required}")
    message(FATAL_ERROR "Missing runtime output ${ROOT}/${required}")
  endif()
endforeach()
file(GLOB files RELATIVE "${ROOT}" "${ROOT}/zspace_core*.js" "${ROOT}/zspace_core*.wasm" "${ROOT}/zspace_core*.data")
set(entries "")
foreach(name IN LISTS files)
  file(SHA256 "${ROOT}/${name}" hash)
  if(entries)
    string(APPEND entries ",\n")
  endif()
  string(APPEND entries "    {\"name\": \"${name}\", \"sha256\": \"${hash}\"}")
endforeach()
file(WRITE "${ROOT}/runtime-manifest.json" "{\n  \"component\": \"core-io\",\n  \"usd\": true,\n  \"files\": [\n${entries}\n  ]\n}\n")
