include_guard(GLOBAL)

# Resolved paths are deliberately NOT cached: environment/local configuration
# changes must take effect unless the caller explicitly supplies a cache override.
function(zspace_resolve_openusd)
  get_filename_component(core_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/OpenUSD.local.cmake" OPTIONAL)
  if(EMSCRIPTEN)
    set(platform wasm32)
    set(env_key ZSPACE_OPENUSD_ROOT_WASM32)
  elseif(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(platform windows-x64)
    set(env_key ZSPACE_OPENUSD_ROOT_WINDOWS_X64)
  else()
    message(FATAL_ERROR "Core OpenUSD: unsupported SDK target; supported targets are Windows x64 and Emscripten wasm32")
  endif()
  if(ZSPACE_OPENUSD_ROOT)
    set(root "${ZSPACE_OPENUSD_ROOT}")
    set(provider "CMake override")
  elseif(DEFINED ENV{${env_key}} AND NOT "$ENV{${env_key}}" STREQUAL "")
    set(root "$ENV{${env_key}}")
    set(provider "${env_key}")
  elseif(DEFINED ENV{ZSPACE_OPENUSD_ROOT} AND NOT "$ENV{ZSPACE_OPENUSD_ROOT}" STREQUAL "")
    set(root "$ENV{ZSPACE_OPENUSD_ROOT}")
    set(provider "ZSPACE_OPENUSD_ROOT environment")
  elseif(EXISTS "${core_root}/third_party/openusd/${platform}/26.08/include/pxr/pxr.h")
    set(root "${core_root}/third_party/openusd/${platform}/26.08")
    set(provider "repository SDK")
  else()
    set(root "${${env_key}}")
    set(provider "Core OpenUSD.local.cmake")
  endif()
  if(NOT root)
    message(FATAL_ERROR "Core OpenUSD: no ${platform} SDK. Set ${env_key} in the environment or cmake/OpenUSD.local.cmake, or install third_party/openusd/${platform}/26.08")
  endif()
  file(TO_CMAKE_PATH "${root}" root)
  get_filename_component(root "${root}" ABSOLUTE)
  foreach(required include/pxr/pxr.h)
    if(NOT EXISTS "${root}/${required}")
      message(FATAL_ERROR "Core OpenUSD: invalid ${provider}: missing ${root}/${required}")
    endif()
  endforeach()
  if(NOT ZSPACE_OPENUSD_RUNTIME_ROOT AND NOT EXISTS "${root}/pxrConfig.cmake")
    message(FATAL_ERROR "Core OpenUSD: missing ${root}/pxrConfig.cmake")
  endif()
  if(EMSCRIPTEN AND NOT EXISTS "${root}/lib/libusd_usd.a")
    message(FATAL_ERROR "Core OpenUSD: expected WASM static archives at ${root}; native SDKs cannot be used")
  elseif(WIN32)
    file(GLOB native_libraries "${root}/lib/*usd*.lib")
    if(NOT native_libraries)
      message(FATAL_ERROR "Core OpenUSD: expected native import/static libraries at ${root}; WASM SDKs cannot be used")
    endif()
  endif()
  set(runtime "${root}")
  if(ZSPACE_OPENUSD_RUNTIME_ROOT)
    set(runtime "${ZSPACE_OPENUSD_RUNTIME_ROOT}")
  endif()
  if(NOT EXISTS "${runtime}/lib/usd/plugInfo.json")
    message(FATAL_ERROR "Core OpenUSD: missing schema registry ${runtime}/lib/usd/plugInfo.json")
  endif()
  if(EMSCRIPTEN AND NOT EXISTS "${root}/lib/libtbb.a")
    message(FATAL_ERROR "Core OpenUSD: missing WASM TBB archive")
  endif()
  message(STATUS "Core OpenUSD: ${platform}; ${provider}; ${root}")
  set(ZSPACE_OPENUSD_ROOT "${root}" PARENT_SCOPE)
endfunction()

# OpenUSD stays private to IO. Standard SDKs provide pxrConfig.cmake; split
# vendor devkits can supply headers/import libraries and runtime separately.
function(zspace_link_openusd target)
  zspace_resolve_openusd()
  set(ZSPACE_OPENUSD_ROOT "${ZSPACE_OPENUSD_ROOT}" PARENT_SCOPE)
  if(EMSCRIPTEN)
    file(GLOB archives "${ZSPACE_OPENUSD_ROOT}/lib/libusd_*.a")
    set(CMAKE_CXX_LINK_LIBRARY_USING_WHOLE_ARCHIVE "LINKER:--whole-archive" "<LINK_ITEM>" "LINKER:--no-whole-archive" PARENT_SCOPE)
    set(CMAKE_CXX_LINK_LIBRARY_USING_WHOLE_ARCHIVE_SUPPORTED TRUE PARENT_SCOPE)
    foreach(archive IN LISTS archives)
      target_link_libraries(${target} PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,${archive}>")
    endforeach()
    target_link_libraries(${target} PRIVATE "${ZSPACE_OPENUSD_ROOT}/lib/libtbb.a")
    target_include_directories(${target} SYSTEM PRIVATE "${ZSPACE_OPENUSD_ROOT}/include")
    target_compile_definitions(${target} PRIVATE PXR_STATIC)
    target_link_options(${target} PRIVATE -pthread -fexceptions --use-port=zlib
      "SHELL:--embed-file \"${ZSPACE_OPENUSD_ROOT}/lib/usd@/usd\"")
    return()
  endif()
  if(ZSPACE_OPENUSD_RUNTIME_ROOT)
    if(NOT WIN32)
      message(FATAL_ERROR "Split OpenUSD devkits are currently supported on Windows only")
    endif()
    target_include_directories(${target} SYSTEM PRIVATE "${ZSPACE_OPENUSD_ROOT}/include")
    set(ZSPACE_OPENUSD_EXTRA_INCLUDE_DIR "" CACHE PATH "Optional Python headers required by a vendor USD devkit")
    set(ZSPACE_OPENUSD_EXTRA_LIBRARY_DIR "" CACHE PATH "Optional Python libraries required by a vendor USD devkit")
    if(ZSPACE_OPENUSD_EXTRA_INCLUDE_DIR)
      target_include_directories(${target} SYSTEM PRIVATE "${ZSPACE_OPENUSD_EXTRA_INCLUDE_DIR}")
    endif()
    if(ZSPACE_OPENUSD_EXTRA_LIBRARY_DIR)
      target_link_directories(${target} PRIVATE "${ZSPACE_OPENUSD_EXTRA_LIBRARY_DIR}")
    endif()
    target_link_directories(${target} PRIVATE "${ZSPACE_OPENUSD_ROOT}/lib")
    foreach(component tf gf vt work plug ar sdf pcp usd usdGeom usdUtils)
      unset(zspaceUsdLibrary)
      find_library(zspaceUsdLibrary NAMES usd_${component} ${component}
        PATHS "${ZSPACE_OPENUSD_ROOT}/lib" NO_DEFAULT_PATH NO_CACHE REQUIRED)
      target_link_libraries(${target} PRIVATE "${zspaceUsdLibrary}")
    endforeach()
    # Python-enabled vendor devkits expose Python symbols through VtValue.
    # Headless SDKs do not need these optional libraries.
    foreach(component boost python)
      unset(zspaceUsdLibrary)
      find_library(zspaceUsdLibrary NAMES usd_${component}
        PATHS "${ZSPACE_OPENUSD_ROOT}/lib" NO_DEFAULT_PATH NO_CACHE)
      if(zspaceUsdLibrary)
        target_link_libraries(${target} PRIVATE "${zspaceUsdLibrary}")
      endif()
    endforeach()
  else()
    set(pxr_DIR "${ZSPACE_OPENUSD_ROOT}")
    set(TBB_DIR "${ZSPACE_OPENUSD_ROOT}/lib/cmake/TBB")
    list(PREPEND CMAKE_PREFIX_PATH "${ZSPACE_OPENUSD_ROOT}")
    set(PXR_FIND_TBB_IN_CONFIG ON)
    find_package(pxr CONFIG REQUIRED PATHS "${ZSPACE_OPENUSD_ROOT}" NO_DEFAULT_PATH)
    # Monolithic SDKs expose component names as INTERFACE targets only.
    # usd_m carries the actual shared library/import library (usd_ms on Windows).
    if(TARGET usd_m)
      target_link_libraries(${target} PRIVATE usd_m)
    else()
      target_link_libraries(${target} PRIVATE usd usdGeom usdUtils)
    endif()
    if(EMSCRIPTEN)
      set(ZSPACE_OPENUSD_TARGETS "${PXR_LIBRARIES}" PARENT_SCOPE)
    endif()
  endif()
endfunction()
