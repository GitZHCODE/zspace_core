@PACKAGE_INIT@

set(zspace_WITH_OPENUSD @ZSPACE_IO_WITH_OPENUSD@)
if(@ZSPACE_IO_WITH_OPENUSD@ AND NOT @ZSPACE_BUILD_SHARED@)
  set(PXR_FIND_TBB_IN_CONFIG ON)
  set(pxr_DIR "${PACKAGE_PREFIX_DIR}/share/zspace/openusd")
  set(TBB_DIR "${PACKAGE_PREFIX_DIR}/share/zspace/openusd/lib/cmake/TBB")
  find_package(pxr CONFIG REQUIRED PATHS "${PACKAGE_PREFIX_DIR}/share/zspace/openusd" NO_DEFAULT_PATH)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/zspaceTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ZSpaceRuntime.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/zspaceRuntimeFiles.cmake" OPTIONAL)

check_required_components(zspace)
